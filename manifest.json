{
  "manifest_version": 3,
  "name": "Citesmith",
  "version": "2025.0.0",
  "description": "Enables more efficient downloading/managing PDF references and picking BibTeX references from various sites.",
  "permissions": [
    "activeTab",
    "downloads",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "https://www.sciencedirect.com/*",
    "https://onlinelibrary.wiley.com/*",
    "https://link.springer.com/*",
    "https://arxiv.org/*"
  ],
  "action": {
    "default_icon": "./assets/fig/icon.png",
    "default_popup": "./popup.html",
    "default_title": "Citesmith"
  },
  "icons": {
    "128": "./assets/fig/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.sciencedirect.com/science/article/*",
        "https://onlinelibrary.wiley.com/doi/*",
        "https://link.springer.com/article/*",
        "https://arxiv.org/abs/*"
      ],
      "js": [
        "./ris2bibtex.js",
        "./BibTeXUtils.js",
        "./content.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/svg/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "./background.js"
  }
}
