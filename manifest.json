{
  "manifest_version": 3,
  "name": "Citesmith",
  "version": "2026.1.0",
  "description": "Enables more efficient downloading/managing PDF references and picking BibTeX references from various sites.",
  "permissions": [
    "downloads",
    "storage",
    "clipboardWrite",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://arxiv.org/*",
    "https://www.nature.com/*",
    "https://citation-needed.springer.com/*",
    "https://link.springer.com/*",
    "https://onlinelibrary.wiley.com/*",
    "https://www.sciencedirect.com/*",
    "https://pdf.sciencedirectassets.com/*"
  ],
  "action": {
    "default_icon": "./assets/fig/icon.png",
    "default_popup": "./popup.html",
    "default_title": "Citesmith"
  },
  "icons": {
    "128": "./assets/fig/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arxiv.org/abs/*",
        "https://www.nature.com/articles/*",
        "https://link.springer.com/article/*",
        "https://onlinelibrary.wiley.com/doi/*",
        "https://www.sciencedirect.com/science/article/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  }
}
