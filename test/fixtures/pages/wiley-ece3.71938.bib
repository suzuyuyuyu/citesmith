title = {Effect of Environmental Drivers on Functional Traits of Salvadora Population in the Semi-Arid Regions: A Case Study From Division Sahiwal Pakistan},
journal = {Ecology and Evolution},
volume = {15},
number = {9},
pages = {e71938},
keywords = {distribution, Division Sahiwal, edaphic factors, functional traits, habitat types, Pakistan, S. oleoides, S. persica, Salvadora, semi-arid lowlands},
